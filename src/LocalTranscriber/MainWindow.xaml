<Window x:Class="LocalTranscriber.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Local Transcriber" Width="1320" Height="920" MinWidth="980" MinHeight="720" FontFamily="Segoe UI" FontSize="14" Closing="ClosingApp" AllowDrop="True" Drop="FilesDropped">
 <Window.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="MinWidth" Value="130"/></Style>
  <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="RowHeight" Value="42"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/></Style>
  <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="MinWidth" Value="174"/><Setter Property="Padding" Value="16,12"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <TextBlock DockPanel.Dock="Left" Text="Local Transcriber" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add workspace" Click="AddWorkspace"/><Button Content="Add files" Click="AddFiles"/></StackPanel>
   <ComboBox x:Name="WorkspaceBox" SelectionChanged="WorkspaceChanged" AutomationProperties.Name="Workspace" MaxWidth="440" HorizontalAlignment="Left"/>
  </DockPanel>
  <TabControl x:Name="Navigation" Grid.Row="1" TabStripPlacement="Left" SelectionChanged="Navigated">
   <TabItem Header="Library">
    <Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Style="{StaticResource PageTitle}" Text="Library"/>
     <StackPanel Grid.Row="1"><TextBlock Text="Add a workspace and recording to begin. Files are linked unless you explicitly choose Import copy."/>
      <WrapPanel Margin="0,12,0,0"><Button Content="Open workspace" Click="OpenWorkspace"/><Button Content="Rename" Click="RenameWorkspace"/><Button Content="Move up" Click="ReorderWorkspace"/><Button Content="Locate folder" Click="LocateWorkspace"/><Button Content="Remove pointer" Click="RemoveWorkspace"/><Button Content="Refresh" Click="RefreshLibrary"/><Button Content="Import copy" Click="CopyFiles"/></WrapPanel>
      <TextBox x:Name="LibrarySearch" TextChanged="SearchLibrary" AutomationProperties.Name="Search recordings" ToolTip="Filter imported recording names"/>
     </StackPanel>
     <DataGrid x:Name="MediaGrid" Grid.Row="2" IsReadOnly="True" SelectionMode="Extended" SelectionChanged="MediaSelected" MouseDoubleClick="OpenTranscribe" AutomationProperties.Name="Recordings">
      <DataGrid.Columns><DataGridTextColumn Header="Recording" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="120"/><DataGridTextColumn Header="Bytes" Binding="{Binding Size}" Width="130"/></DataGrid.Columns>
     </DataGrid>
     <DockPanel Grid.Row="3" Margin="0,12,0,0"><TextBlock Text="Transcription history" Style="{StaticResource SectionTitle}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Open result" Click="OpenJob"/><Button Content="Resume selected" Click="ResumeJob"/><Button Content="Cancel selected" Click="CancelJob"/></StackPanel></DockPanel>
     <DataGrid x:Name="JobsGrid" Grid.Row="4" IsReadOnly="True" MouseDoubleClick="OpenJob" AutomationProperties.Name="Jobs"><DataGrid.Columns><DataGridTextColumn Header="Recording" Binding="{Binding SourceName}" Width="*"/><DataGridTextColumn Header="Model" Binding="{Binding ModelId}" Width="160"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="Audio processed" Binding="{Binding ProgressText}" Width="145"/><DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="220"/></DataGrid.Columns></DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="Transcribe">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16">
     <TextBlock Style="{StaticResource PageTitle}" Text="Transcribe"/><TextBlock x:Name="SourceInfo" Text="Select a recording in Library, or add files." Margin="0,0,0,12"/>
     <TextBlock Text="Audio track"/><ComboBox x:Name="TrackBox" AutomationProperties.Name="Audio track"/>
     <TextBlock Text="Speech model"/><ComboBox x:Name="SpeechModelBox" SelectionChanged="SpeechModelChanged" AutomationProperties.Name="Speech model"/>
     <TextBlock x:Name="SpeechCapability" Margin="0,0,0,12"/>
     <TextBlock Text="Language"/><ComboBox x:Name="LanguageBox" AutomationProperties.Name="Language"/>
     <TextBlock Text="Audio cleanup"/><ComboBox x:Name="CleanupBox" SelectedIndex="0" AutomationProperties.Name="Audio cleanup"><ComboBoxItem Content="Automatic"/><ComboBoxItem Content="Off"/><ComboBoxItem Content="Enhanced"/></ComboBox>
     <TextBlock Text="Enhanced uses FFT noise reduction. It can alter voices; compare a short sample before use." Margin="0,0,0,12"/>
     <WrapPanel><Button Content="Play source" Click="PlaySource"/><Button Content="Preview original (15 s)" Click="PreviewOriginal"/><Button Content="Preview enhanced (15 s)" Click="PreviewEnhanced"/></WrapPanel>
     <Expander Header="Advanced"><StackPanel Margin="12"><TextBlock Text="Key terms / names (Whisper only; Parakeet cannot use hints)"/><TextBox x:Name="HintsBox" MaxLength="4000" AutomationProperties.Name="Key terms and names"/><TextBlock Text="VAD threshold (0.1–0.9; default 0.5)"/><TextBox x:Name="VadBox" Text="0.5" AutomationProperties.Name="VAD threshold"/></StackPanel></Expander>
     <WrapPanel Margin="0,16,0,0"><Button Content="Transcribe selected recording" Click="Transcribe"/><Button Content="Queue selected files" Click="TranscribeBatch"/><Button Content="Cancel active transcription" Click="CancelActive"/></WrapPanel>
     <TextBlock x:Name="StageText" Text="Ready" Margin="0,8,0,8"/><ProgressBar x:Name="JobProgress" Height="8" Minimum="0" Maximum="100" AutomationProperties.Name="Processed audio progress"/>
     <TextBlock Text="Each new transcription creates an independent raw result. Originals and existing edits remain intact." Margin="0,16,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Transcript">
    <Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Style="{StaticResource PageTitle}" Text="Transcript"/><TextBlock x:Name="TranscriptState" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
     <MediaElement x:Name="Player" Grid.Row="1" LoadedBehavior="Manual" UnloadedBehavior="Close" Stretch="Uniform" MediaOpened="MediaOpened" MediaFailed="MediaFailed" AutomationProperties.Name="Recording preview"/>
     <DockPanel Grid.Row="2"><StackPanel Orientation="Horizontal"><Button Content="Play / pause" Click="TogglePlay"/><Button Content="Stop" Click="StopPlaying"/><Button Content="Compatible audio preview" Click="CompatiblePreview"/></StackPanel><TextBlock x:Name="PlaybackTime" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8"/><Slider x:Name="SeekSlider" Minimum="0" Maximum="1" PreviewMouseUp="SeekMedia" AutomationProperties.Name="Playback position"/></DockPanel>
     <WrapPanel Grid.Row="3"><TextBox x:Name="TranscriptSearch" Width="200" TextChanged="SearchTranscript" ToolTip="Search transcript" AutomationProperties.Name="Search transcript"/><ComboBox x:Name="VersionBox" SelectedIndex="0" SelectionChanged="TranscriptVersionChanged" AutomationProperties.Name="Transcript version"><ComboBoxItem Content="Edited / latest"/><ComboBoxItem Content="Raw model result"/></ComboBox><Button Content="Save edits" Click="SaveTranscript"/><Button Content="Undo" Click="UndoTranscript"/><Button Content="Redo" Click="RedoTranscript"/><Button Content="Revert to raw" Click="RevertTranscript"/></WrapPanel>
     <DataGrid x:Name="TranscriptGrid" Grid.Row="4" SelectionChanged="SeekSegment" MouseDoubleClick="SeekTranscriptClick" CellEditEnding="TranscriptEdited" RowHeight="NaN" AutomationProperties.Name="Timed transcript editor">
      <DataGrid.Columns><DataGridTextColumn Header="Start" Binding="{Binding StartTime}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="End" Binding="{Binding EndTime}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Speaker (manual)" Binding="{Binding SpeakerId}" Width="150"/><DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="8"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
     </DataGrid>
     <WrapPanel Grid.Row="5" Margin="0,12,0,0"><ComboBox x:Name="ExportFormat" SelectedIndex="0" AutomationProperties.Name="Transcript export format"><ComboBoxItem Content="txt"/><ComboBoxItem Content="md"/><ComboBoxItem Content="json"/><ComboBoxItem Content="csv"/><ComboBoxItem Content="srt"/><ComboBoxItem Content="vtt"/></ComboBox><ComboBox x:Name="TimestampBox" SelectedIndex="2" AutomationProperties.Name="Timestamp style"><ComboBoxItem Content="None"/><ComboBoxItem Content="Start"/><ComboBoxItem Content="Start–end"/></ComboBox><CheckBox x:Name="SpeakersToggle" Content="Speakers" IsChecked="True" VerticalAlignment="Center" Margin="8"/><CheckBox x:Name="CsvBom" Content="CSV BOM (Excel)" VerticalAlignment="Center" Margin="8"/><Button Content="Export transcript" Click="ExportTranscript"/><Button Content="Open source folder" Click="OpenSourceFolder"/><Button Content="Open output folder" Click="OpenOutputFolder"/></WrapPanel>
    </Grid>
   </TabItem>
   <TabItem Header="Summarize">
    <Grid Margin="24,16"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,0">
      <TextBlock Style="{StaticResource PageTitle}" Text="Summarize"/><TextBlock Text="Uses the transcript version selected in Transcript. Review uncertain speech before summarizing." Margin="0,0,0,16"/>
      <TextBlock Text="Summary model"/><ComboBox x:Name="SummaryModelBox" SelectionChanged="SummaryModelChanged" AutomationProperties.Name="Summary model"/><TextBlock x:Name="SummaryCapability" Margin="0,0,0,12"/>
      <TextBlock Text="Context and terminology"/><TextBox x:Name="ContextBox" AcceptsReturn="True" Height="110" TextWrapping="Wrap" MaxLength="32000" AutomationProperties.Name="Context and terminology"/>
      <WrapPanel><Button Content="Save glossary" Click="SaveGlossary"/><Button Content="Import glossary" Click="ImportGlossary"/><Button Content="Export glossary" Click="ExportGlossary"/></WrapPanel>
      <TextBlock Text="Output style"/><ComboBox x:Name="TemplateBox" SelectedIndex="0" AutomationProperties.Name="Summary template"><ComboBoxItem Content="Concise summary"/><ComboBoxItem Content="Detailed notes"/><ComboBoxItem Content="Meeting notes"/><ComboBoxItem Content="Decisions and actions"/><ComboBoxItem Content="Key points"/><ComboBoxItem Content="Custom template"/></ComboBox>
      <TextBox x:Name="CustomTemplateBox" TextWrapping="Wrap" MaxLength="4000" ToolTip="Custom template instructions" AutomationProperties.Name="Custom template"/>
      <TextBlock Text="Output language"/><ComboBox x:Name="SummaryLanguageBox" SelectedIndex="0" AutomationProperties.Name="Summary language"><ComboBoxItem Content="Same as transcript"/><ComboBoxItem Content="English"/><ComboBoxItem Content="French"/></ComboBox>
      <Expander Header="Advanced"><StackPanel Margin="8"><TextBlock Text="Context tokens (Auto suggests 2048 or 4096; max 8192)"/><TextBox x:Name="ContextTokensBox" Text="4096" AutomationProperties.Name="Context tokens"/><TextBlock Text="Maximum output tokens (64–2048)"/><TextBox x:Name="OutputTokensBox" Text="768" AutomationProperties.Name="Output tokens"/><TextBlock Text="Temperature (0–2)"/><TextBox x:Name="TemperatureBox" Text="0.1" AutomationProperties.Name="Temperature"/><TextBlock Text="Top-p / top-k"/><TextBox x:Name="TopPBox" Text="0.9" AutomationProperties.Name="Top-p"/><TextBox x:Name="TopKBox" Text="50" AutomationProperties.Name="Top-k"/><TextBlock Text="Repetition penalty / batch size / seed"/><TextBox x:Name="RepeatBox" Text="1.1" AutomationProperties.Name="Repetition penalty"/><TextBox x:Name="BatchBox" Text="256" AutomationProperties.Name="Batch size"/><TextBox x:Name="SeedBox" Text="42" AutomationProperties.Name="Seed"/><TextBlock Text="System instructions"/><TextBox x:Name="SystemPromptBox" AcceptsReturn="True" Height="140" TextWrapping="Wrap" MaxLength="12000" AutomationProperties.Name="System instructions"/><Button Content="Reset defaults" Click="ResetSummarySettings"/></StackPanel></Expander>
      <WrapPanel Margin="0,16,0,0"><Button x:Name="GenerateButton" Content="Generate summary" Click="GenerateSummary"/><Button Content="Cancel" Click="CancelOperation"/></WrapPanel>
      <TextBlock x:Name="SummaryStage" Text="Choose a completed transcript and an installed summary model."/>
     </StackPanel></ScrollViewer>
     <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Style="{StaticResource SectionTitle}" Text="Summary · editable"/><TextBox x:Name="SummaryEditor" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="SummaryEdited" AutomationProperties.Name="Summary editor"/>
      <TextBlock Grid.Row="2" Style="{StaticResource SectionTitle}" Text="Source transcript"/><TextBox x:Name="SourceTranscript" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Summary source transcript"/>
      <WrapPanel Grid.Row="4" Margin="0,12,0,0"><Button Content="Save summary edits" Click="SaveSummary"/><ComboBox x:Name="SummaryFormat" SelectedIndex="0" AutomationProperties.Name="Summary export format"><ComboBoxItem Content="md"/><ComboBoxItem Content="txt"/><ComboBoxItem Content="json"/></ComboBox><Button Content="Export summary" Click="ExportSummary"/></WrapPanel>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem x:Name="SpeechPage" Header="Speech-to-text">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16">
     <TextBlock Style="{StaticResource PageTitle}" Text="Speech-to-text"/>
     <TextBlock Text="Record and test speech here, or open the floating widget to dictate into the selected text box in another app." Margin="0,0,0,12"/>
     <Grid x:Name="SpeechOptions"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="Speech model"/><ComboBox x:Name="DictationModelBox" SelectionChanged="DictationModelChanged" AutomationProperties.Name="Dictation speech model"/><TextBlock x:Name="DictationCapability"/><TextBlock Text="Spoken language (auto = detect)"/><ComboBox x:Name="DictationLanguageBox" AutomationProperties.Name="Dictation language"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Microphone"/><ComboBox x:Name="MicrophoneBox" AutomationProperties.Name="Dictation microphone"/><Button Content="Refresh microphones" Click="RefreshMicrophones" HorizontalAlignment="Left"/><CheckBox x:Name="DictationRewrite" Content="Process with the language model (optional)" Margin="0,8,0,8"/><TextBlock Text="Use the selected prompt for light cleanup, document structure or your own instructions. Review AI edits."/><ComboBox x:Name="DictationLlmBox" SelectionChanged="DictationCleanupChanged" AutomationProperties.Name="Dictation cleanup model"/><TextBlock x:Name="CleanupCapability"/></StackPanel>
     </Grid>
     <Grid Height="100"><Ellipse x:Name="WorkbenchCircle" Width="22" Height="22" Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Opacity="0.8" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0" AutomationProperties.Name="Microphone volume circle"/><TextBlock x:Name="RecordingTime" Text="Ready" Margin="140,0,0,0" VerticalAlignment="Center"/><TextBlock Text="The circle grows with microphone volume." HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <WrapPanel><Button x:Name="WorkbenchRecord" Content="Record test" Click="RecordWorkbench"/><Button x:Name="WorkbenchStop" Content="Stop &amp; transcribe" Click="StopDictation" IsEnabled="False"/><Button x:Name="WorkbenchCancel" Content="Cancel" Click="CancelDictation" IsEnabled="False"/><Button x:Name="TestSpeechFile" Content="Test audio file…" Click="TestDictationFile"/><Button x:Name="ShowWidgetButton" Content="Open floating widget" Click="ShowWidget"/><Button Content="Save speech settings" Click="SaveSpeechSettings"/></WrapPanel>
     <TextBlock x:Name="DictationStatus" Text="Choose an installed model and press Record test. The widget inserts only while the original text box remains focused." Margin="0,8,0,12" AutomationProperties.LiveSetting="Polite"/>
     <StackPanel x:Name="SpeechPromptOptions">
      <WrapPanel><TextBlock Text="Processing prompt" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="SpeechPromptBox" Width="260" SelectionChanged="SpeechPromptChanged" AutomationProperties.Name="Speech processing prompt"/><Button Content="New prompt" Click="AddSpeechPrompt"/><Button x:Name="DeleteSpeechPromptButton" Content="Delete prompt" Click="DeleteSpeechPrompt"/></WrapPanel>
      <Expander x:Name="SpeechPromptEditor" Header="Edit system instructions and output format"><StackPanel Margin="12,12">
       <TextBlock Text="Prompt name"/><TextBox x:Name="SpeechPromptName" MaxLength="80" AutomationProperties.Name="Speech prompt name"/>
       <TextBlock Text="System instructions · complete override"/><TextBox x:Name="SpeechPromptInstructions" Height="200" MaxLength="12000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Speech processing system instructions"/>
       <CheckBox x:Name="SpeechPromptMarkdown" Content="Allow Markdown output" Margin="0,8"/>
       <TextBlock Text="These instructions replace the built-in editing instructions. The selected output-format rule is appended: plain text prohibits Markdown and also strips it programmatically; Markdown preserves formatting. Changes apply to the workbench and widget when language-model processing is on."/>
       <WrapPanel><Button Content="Save prompt" Click="SaveSpeechPrompt"/><Button Content="Restore default instructions" Click="ResetSpeechPrompt"/></WrapPanel>
      </StackPanel></Expander>
     </StackPanel>
     <TextBlock Style="{StaticResource SectionTitle}" Text="Compare speech model and processed output"/><TextBlock x:Name="SpeechResultInfo"/><TextBlock x:Name="SpeechTiming" AutomationProperties.Name="Speech processing elapsed times"/>
     <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Raw speech model output · unchanged"/><TextBox x:Name="RawDictation" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="200" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Raw dictation"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Processed result · ready to use"/><TextBox x:Name="FinalDictation" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="200" AutomationProperties.Name="Final dictation result"/></StackPanel></Grid>
     <WrapPanel><Button x:Name="ApplySpeechPromptButton" Content="Apply selected prompt to this speech" Click="ApplySpeechPrompt" IsEnabled="False"/><Button Content="Copy result" Click="CopyDictation"/><Button Content="Open saved recording and results" Click="OpenDictationFolder"/><Button x:Name="RestoreClipboardButton" Content="Restore previous clipboard" Click="RestoreDictationClipboard" Visibility="Collapsed"/></WrapPanel>
     <Expander x:Name="VocabularyExpander" Header="Vocabulary map · after transcription, before optional cleanup"><StackPanel x:Name="VocabularyPanel" Margin="12,16">
      <CheckBox x:Name="VocabularyToggle" Content="Apply vocabulary replacements to new transcriptions" Margin="0,0,0,8"/>
      <TextBlock Text="Literal phrases, ignoring letter case; matches whole words. Longer phrases win and replacements run once. Raw ASR is always kept. Edit the example rules to suit your vocabulary."/>
      <DataGrid x:Name="VocabularyGrid" Height="150" RowHeight="NaN" AutomationProperties.Name="Vocabulary replacement map"><DataGrid.Columns><DataGridTextColumn Header="Heard phrase" Binding="{Binding Heard, UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridTextColumn Header="Replace with" Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns></DataGrid>
      <WrapPanel Margin="0,8,0,0"><Button Content="Add phrase" Click="AddVocabulary"/><Button Content="Remove selected" Click="RemoveVocabulary"/><Button Content="Save vocabulary" Click="SaveSpeechSettings"/></WrapPanel>
     </StackPanel></Expander>
     <Expander Header="Intermediate text · line breaks removed, then vocabulary applied"><TextBox x:Name="MappedDictation" Margin="0,12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Vocabulary-corrected dictation"/></Expander>
     <TextBlock Text="Recordings and results are saved locally in app data → dictation. Workbench tests never insert into another app. The widget never presses Send or Submit. If focus changes or cleanup fails, copy the preserved result after reviewing it." Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="ModelsPage" Header="Models">
    <Grid Margin="24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Style="{StaticResource PageTitle}" Text="Models"/>
     <WrapPanel Grid.Row="1"><ComboBox x:Name="ModelRoleBox" SelectedIndex="0" SelectionChanged="FilterModels" AutomationProperties.Name="Model type filter"><ComboBoxItem Content="All models"/><ComboBoxItem Content="Speech recognition"/><ComboBoxItem Content="Language models"/></ComboBox><TextBox x:Name="ModelSearch" Width="220" TextChanged="FilterModels" AutomationProperties.Name="Search models"/><TextBlock x:Name="ModelUsage" Margin="12"/></WrapPanel>
     <DataGrid x:Name="ModelsGrid" Grid.Row="2" IsReadOnly="True" SelectionChanged="ModelSelected" AutomationProperties.Name="Model catalogue"><DataGrid.Columns><DataGridTextColumn Header="Model" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="State" Binding="{Binding InstalledStatus}" Width="110"/><DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80"/><DataGridTextColumn Header="Download" Binding="{Binding SizeText}" Width="110"/><DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" Width="120"/><DataGridTextColumn Header="License" Binding="{Binding License}" Width="190"/></DataGrid.Columns></DataGrid>
     <TextBlock x:Name="ModelDetails" Grid.Row="3" Margin="0,16,0,16"/>
     <WrapPanel Grid.Row="4"><Button Content="Download selected model" Click="DownloadModel"/><Button Content="Cancel download" Click="CancelOperation"/><Button Content="Import compatible model" Click="ImportModel"/><Button Content="Remove model" Click="DeleteModel"/><Button Content="Open location" Click="OpenModelLocation"/><Button Content="Provenance / model card" Click="OpenModelCard"/></WrapPanel>
     <ProgressBar x:Name="DownloadProgress" Grid.Row="5" Height="8" Minimum="0" Maximum="100" AutomationProperties.Name="Model download progress"/>
    </Grid>
   </TabItem>
   <TabItem x:Name="HelpPage" Header="Help">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16">
     <TextBlock Style="{StaticResource PageTitle}" Text="Help"/>
     <StackPanel x:Name="TutorialPanel" Visibility="Collapsed" Margin="0,0,0,20">
      <TextBlock Style="{StaticResource SectionTitle}" Text="Welcome · start with these four steps"/>
      <TextBlock Text="1. Choose a model. Open Models and install Parakeet for fast multilingual speech or Whisper for a choice of model sizes and forced languages. For optional dictation cleanup, install Qwen2.5 7B-Instruct. Model downloads require internet; inference runs locally on CPU." Margin="0,0,0,12"/>
      <Button Content="Open Models" Click="OpenModelsPage" HorizontalAlignment="Left"/>
      <TextBlock Text="2. Test your microphone. Open Speech-to-text, select your microphone and speech model, then Record test. The expanding circle confirms sound is reaching the app. Stop &amp; transcribe shows the result without inserting it anywhere." Margin="0,0,0,12"/>
      <TextBlock Text="3. Choose how to process speech. Leave cleanup off for transcription only, or enable the language model to remove fillers and resolve spoken corrections. Edit the vocabulary map for frequently misheard names. Save speech settings. Raw audio and raw speech remain available." Margin="0,0,0,12"/>
      <TextBlock Text="4. Dictate into another app. Open the floating widget, select your destination text box, then click Record in the widget. Speak, click Stop &amp; transcribe, and keep that text box focused until the result arrives. If the destination changes, copy the result from the workbench." Margin="0,0,0,12"/>
      <Button Content="Got it · open Speech-to-text" Click="FinishTutorial" HorizontalAlignment="Left"/>
     </StackPanel>
     <WrapPanel><Button Content="Replay getting-started tutorial" Click="ShowTutorial"/><Button Content="Open Speech-to-text" Click="OpenSpeechPage"/><Button Content="Full user guide" Click="OpenUserGuide"/></WrapPanel>
     <TextBlock Style="{StaticResource SectionTitle}" Text="Transcribe a recording"/><TextBlock Text="Add a workspace, then add files from the top bar. Choose the recording in Library, select a model in Transcribe, and start. Open the completed job in Library history to edit timed segments, play media or export TXT, Markdown, JSON, CSV, SRT or VTT. Summarize uses your selected transcript version."/>
     <TextBlock Style="{StaticResource SectionTitle}" Text="Microphone and insertion troubleshooting"/><TextBlock Text="If the circle does not move, select the correct microphone and check Windows Settings → Privacy &amp; security → Microphone, including desktop app access. Close applications that use the microphone exclusively. For insertion, select an editable field before clicking Record. Password fields, read-only fields and elevated apps may reject insertion. Leave focus in the original field; otherwise use Copy result. The widget's buttons keep the other app focused."/>
     <TextBlock Style="{StaticResource SectionTitle}" Text="Models, cleanup and vocabulary"/><TextBlock Text="The speech model turns audio into text. Vocabulary replacement then corrects your saved literal phrases, without changing the raw transcript. Optional cleanup uses a separate local language model and can take longer. Review names, numbers and meaning after any AI processing. A cleanup error preserves the vocabulary result for review. Test the same audio file with different installed models in Speech-to-text to compare results."/>
     <TextBlock Style="{StaticResource SectionTitle}" Text="Privacy and saved results"/><TextBlock Text="The microphone records only after you press Record, and stops on Stop, Cancel or app close. Audio and results stay on this PC. No inference is sent to the cloud. Dictation history is in the app-data dictation folder and Library's dictation workspace; recordings remain until you remove them on disk. You can reopen this tutorial whenever you need it."/>
     <WrapPanel Margin="0,16,0,0"><Button Content="Open app data" Click="OpenAppData"/><Button Content="Third-party notices" Click="OpenNotices"/></WrapPanel>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem x:Name="SettingsPage" Header="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,16">
     <TextBlock Style="{StaticResource PageTitle}" Text="Settings"/><TextBlock Style="{StaticResource SectionTitle}" Text="Device and resources"/><TextBlock x:Name="DeviceInfo"/><Button Content="Refresh device information" Click="RefreshDevice" HorizontalAlignment="Left"/>
     <TextBlock Style="{StaticResource SectionTitle}" Text="Storage"/><TextBlock x:Name="StorageInfo"/><WrapPanel Margin="0,12,0,0"><Button Content="Change model storage" Click="MoveModels"/><Button Content="Change cache folder" Click="ChangeCache"/><Button Content="Clean disposable cache" Click="CleanCache"/><Button Content="Open app data" Click="OpenAppData"/></WrapPanel>
     <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance and performance"/><TextBlock Text="Theme"/><ComboBox x:Name="ThemeBox" SelectedIndex="0" SelectionChanged="ThemeChanged" AutomationProperties.Name="Theme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox><TextBlock Text="CPU threads (1–64; default leaves headroom for Windows)"/><TextBox x:Name="ThreadsBox" AutomationProperties.Name="CPU threads"/><Button Content="Save settings" Click="SaveSettings" HorizontalAlignment="Left"/>
     <TextBlock Text="One heavy model runs at a time. Downloads occur only when you request them. Inference uses CPU locally. Microphone capture starts only when you press Record. No telemetry, automatic updates or cloud inference." Margin="0,16,0,0"/>
     <TextBlock Style="{StaticResource SectionTitle}" Text="Capability limits"/><TextBlock Text="Speaker names are manually assigned. Automatic diarization, AI correction suggestions, word alignment, and comparison highlighting are not enabled in this release. Independent runs are available in Library history. Qwen3-ASR and Moonshine are unavailable until an audio-capable Windows CPU adapter is verified."/>
     <WrapPanel Margin="0,16,0,0"><Button Content="User guide" Click="OpenUserGuide"/><Button Content="Third-party notices" Click="OpenNotices"/></WrapPanel>
    </StackPanel></ScrollViewer>
