<Window x:Class="LocalTranscriber.DictationWidget" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Local Transcriber · Dictation" Width="380" Height="490" MinWidth="360" MinHeight="440" ResizeMode="CanResize" Topmost="True" ShowActivated="False" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="14">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
  <TextBlock Text="Dictate into your text box" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,6"/>
  <TextBlock x:Name="ModelName" TextWrapping="Wrap"/>
  <Grid Height="86"><Ellipse x:Name="VolumeCircle" Width="22" Height="22" Fill="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Microphone volume"/><TextBlock x:Name="TimerText" VerticalAlignment="Bottom" HorizontalAlignment="Right" Text="Ready"/></Grid>
  <CheckBox x:Name="RewriteToggle" Content="Process with the language model" Margin="0,0,0,12" AutomationProperties.Name="Optional dictation cleanup"/>
  <WrapPanel><Button x:Name="RecordButton" Content="Record" Padding="14,8" Margin="0,0,8,8"/><Button x:Name="StopButton" Content="Stop &amp; transcribe" Padding="14,8" IsEnabled="False" Margin="0,0,8,8"/><Button x:Name="CancelButton" Content="Cancel" Padding="12,8" IsEnabled="False" Margin="0,0,8,8"/></WrapPanel>
  <TextBlock x:Name="StatusText" Text="Select a text box in another app, then click Record here." TextWrapping="Wrap" MinHeight="55" AutomationProperties.LiveSetting="Polite"/>
  <TextBlock x:Name="TimingText" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Dictation elapsed times"/>
  <WrapPanel Margin="0,8,0,0"><Button x:Name="CopyButton" Content="Copy result" Padding="12,7" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="WorkbenchButton" Content="Workbench" Padding="12,7"/></WrapPanel>
 </StackPanel></ScrollViewer>
</Window>
